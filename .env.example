# Copy this file to .env and fill in real values before running in production.

# Port the server listens on.
PORT=3000

# A long, random, secret string used to sign login session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Optional. Where the NAS backup copy goes — a UNC path is most reliable
# for scheduled tasks (see README). No quotes needed, backslashes don't
# need escaping here (unlike in .js files) — just paste the path exactly
# as it should look, Cyrillic/spaces are fine as-is. Leave unset to skip
# the NAS copy (local backups only).
# NAS_BACKUP_DIR=\\NAS-NAME\backups\repair-log

# Optional. Moves the live database, local backups, and pre-restore safety
# copies to a stable folder OUTSIDE the app's own versioned folder — so
# updating to a new code version never touches them at all. Leave unset to
# keep the current behavior (everything stays inside the app folder).
# DATA_ROOT=D:\CrazyPhoneData

# Optional. Only when the app sits behind a reverse proxy on the same machine
# (nginx/Caddy for HTTPS). Makes the login rate limit count attempts per real
# user IP instead of treating everyone as the proxy's 127.0.0.1. Leave unset
# when browsers connect to the app directly (e.g. over Tailscale).
# TRUST_PROXY=loopback
