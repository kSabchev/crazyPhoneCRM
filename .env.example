# Copy this file to .env and fill in real values before running in production.
# Only SESSION_SECRET is required. Restart the app after changing this file.
#
# Two kinds of settings:
#   1. The server — one app for all shops: port, login secret, data folder,
#      backups, HTTPS.
#   2. Defaults for the shops — the phone number and SMS. A shop that sets
#      its own in Настройки (for the shop picked in the header) uses that
#      instead; a shop that doesn't uses these.

# =============================================================================
# 1. The server
# =============================================================================

# Port the server listens on.
PORT=3000

# A long, random, secret string used to sign login session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=replace-this-with-a-long-random-string

# Optional. Moves the databases (every shop's, and system.db with the
# accounts), local backups and pre-restore safety copies to a stable folder
# OUTSIDE the app's own versioned folder — so updating to a new code version
# never touches them at all. Leave unset to keep everything inside the app
# folder (data\ and backups\).
# DATA_ROOT=D:\CrazyPhoneData

# Optional. Where the NAS copy of each backup goes (every shop's database
# and system.db) — a UNC path is most reliable for scheduled tasks (see
# README). No quotes needed, backslashes don't need escaping here (unlike in
# .js files) — just paste the path exactly as it should look, Cyrillic and
# spaces are fine as-is. Leave unset to skip the NAS copy (local backups only).
# NAS_BACKUP_DIR=\\NAS-NAME\backups\repair-log

# Optional. Only when the app sits behind a reverse proxy (nginx/Caddy for
# HTTPS, or a hosting platform). Makes the login rate limit count attempts
# per real user IP instead of treating everyone as the proxy's address.
# Leave unset when browsers connect to the app directly (e.g. over Tailscale).
# Use "loopback" for a proxy on the same machine, or the number of proxy
# hops (e.g. 1) on a hosting platform such as Render.
# TRUST_PROXY=loopback

# Optional. Set to true once the app is only reached over HTTPS, so the login
# cookie is never sent over plain HTTP. Behind a proxy that handles HTTPS
# (nginx/Caddy, Render) TRUST_PROXY must be set too.
# COOKIE_SECURE=true

# Optional. The address of the SMSAPI.bg service; the default is right.
# SMSAPI_URL=https://api.smsapi.bg

# =============================================================================
# 2. Defaults for the shops
# =============================================================================

# Optional. The phone number printed at the top of the customer card.
# Per shop: Настройки → Име на сервиза → Телефон. Leave unset (and empty in
# Настройки) to print the card without a phone number.
# SHOP_PHONE=0888 123 456

# SMS to customers. Per shop: Настройки → Изпращане на SMS — "Както е зададено
# в .env" uses the lines below; "Собствени настройки" uses the shop's own
# phone or SMSAPI details instead; "Изключени" sends none. Set up ONE way
# here (SMSAPI wins if both are set); with neither, SMS is off for every
# shop that doesn't have its own. See README → "SMS to customers".

# Way 1 — SMSAPI.bg (no phone needed; see README → Option 1).
# SMSAPI_TOKEN=
# Test mode: SMSAPI accepts messages but doesn't deliver or charge them.
# SMSAPI_TEST=true
# Sender name, only once it is approved in the SMSAPI portal (max 11 chars).
# SMSAPI_SENDER=CrazyPhone

# Way 2 — an Android phone with the "SMS Gateway for Android" app (see
# README → Option 2).
# Local server mode — phone on the shop Wi-Fi (address shown in the app):
# SMS_GATEWAY_URL=http://192.168.1.50:8080
# Cloud mode instead — phone anywhere with internet:
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
# SMS_GATEWAY_USER=
# SMS_GATEWAY_PASSWORD=

# =============================================================================
# PUBLIC DEMO ONLY (e.g. the Render deployment) — never on the shop PC.
# =============================================================================
# Wipes the database and fills it with fake demo orders on every start.
# Refuses to run if the database contains real orders.
# DEMO_MODE=true
